{
  "manifest_version": 3,
  "name": "xchange",
  "version": "1.0.0",
  "description": "Select a price to see an estimate in your currency.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "xchange — target currency",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://api.frankfurter.dev/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
